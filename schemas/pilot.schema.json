{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pilot foundation configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "network", "languages", "models", "actions", "limits"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "const": "foundation"
    },
    "network": {
      "const": "disabled"
    },
    "languages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "license", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "role": {
            "enum": ["primary", "comparison"]
          },
          "license": {
            "const": "Apache-2.0"
          },
          "status": {
            "const": "candidate"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-z][a-zA-Z0-9]*$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTurns", "timeoutMs"],
      "properties": {
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        }
      }
    }
  }
}
