{
  "version": 1,
  "id": "P024",
  "request": "« Place deux clips successifs sur une piste vidéo. »",
  "requires": ["isolated-vm", "synthetic-video-4s"],
  "steps": [
    {
      "id": "createProject",
      "action": "project.create",
      "input": {
        "name": "Bench Project",
        "folder": {
          "$ref": "sandbox"
        }
      },
      "saveAs": "createProject",
      "assertions": [
        {
          "actual": {
            "$file": {
              "path": {
                "$ref": "projectPath"
              },
              "read": "exists"
            }
          },
          "op": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "createDocument",
      "action": "workspace.open",
      "input": {
        "workspace": "video",
        "createDocument": true,
        "title": "Bench P024"
      },
      "saveAs": "createDocument",
      "assertions": [
        {
          "actual": {
            "$ref": "createDocument.documentId"
          },
          "op": "exists"
        }
      ]
    },
    {
      "id": "trackState",
      "action": "sequence.state",
      "input": {},
      "saveAs": "trackState",
      "assertions": []
    },
    {
      "id": "nameTrack",
      "action": "track.rename",
      "input": {
        "trackId": {
          "$ref": "trackState.tracks",
          "find": {
            "kind": "video"
          },
          "pick": "id"
        },
        "name": "Montage"
      },
      "saveAs": "nameTrack",
      "assertions": []
    },
    {
      "id": "addClip",
      "action": "clip.add",
      "input": {
        "assetId": {
          "$ref": "fixtures.videoAssetId"
        },
        "trackId": {
          "$ref": "trackState.tracks",
          "find": {
            "kind": "video"
          },
          "pick": "id"
        },
        "start": 0
      },
      "saveAs": "addClip",
      "assertions": [
        {
          "actual": {
            "$ref": "addClip.clipIds"
          },
          "op": "length",
          "expected": 1
        }
      ]
    },
    {
      "id": "firstState",
      "action": "sequence.state",
      "input": {},
      "saveAs": "firstState",
      "assertions": [
        {
          "actual": {
            "$ref": "firstState.tracks",
            "find": {
              "name": "Montage"
            },
            "pick": "clips.0.duration"
          },
          "op": "equal",
          "expected": 4000000
        }
      ]
    },
    {
      "id": "secondClip",
      "action": "clip.add",
      "input": {
        "assetId": {
          "$ref": "fixtures.videoAssetId"
        },
        "trackId": {
          "$ref": "trackState.tracks",
          "find": {
            "kind": "video"
          },
          "pick": "id"
        },
        "start": 4000000
      },
      "saveAs": "secondClip",
      "assertions": [
        {
          "actual": {
            "$ref": "secondClip.clipIds"
          },
          "op": "length",
          "expected": 1
        }
      ]
    },
    {
      "id": "sequence",
      "action": "sequence.state",
      "input": {},
      "saveAs": "sequence",
      "assertions": [
        {
          "actual": {
            "$ref": "sequence.tracks",
            "find": {
              "name": "Montage"
            },
            "pick": "clips"
          },
          "op": "length",
          "expected": 2
        },
        {
          "actual": {
            "$ref": "sequence.tracks",
            "find": {
              "name": "Montage"
            },
            "pick": "clips.0.start"
          },
          "op": "equal",
          "expected": 0
        },
        {
          "actual": {
            "$ref": "sequence.tracks",
            "find": {
              "name": "Montage"
            },
            "pick": "clips.0.end"
          },
          "op": "equal",
          "expected": 4000000
        },
        {
          "actual": {
            "$ref": "sequence.tracks",
            "find": {
              "name": "Montage"
            },
            "pick": "clips.1.start"
          },
          "op": "equal",
          "expected": 4000000
        },
        {
          "actual": {
            "$ref": "sequence.duration"
          },
          "op": "equal",
          "expected": 8000000
        }
      ]
    }
  ],
  "blockers": [
    "Fournisseur de fixture vidéo synthétique/catalogue invité requis ; aucun assetId fictif ni téléchargement implicite."
  ],
  "trainingApproved": false,
  "requiredBindings": ["fixtures"]
}
