{
  "version": 1,
  "id": "P055",
  "request": "Mets la priorité 20 de la carte Hero de côté, puis restaure cette remise.",
  "requires": ["guest-git-identity"],
  "steps": [
    {
      "id": "create-project",
      "action": "project.create",
      "input": {
        "name": "Bench Project",
        "folder": {
          "$ref": "sandbox"
        }
      },
      "assertions": [
        {
          "actual": {
            "$file": {
              "path": {
                "$ref": "projectPath"
              },
              "read": "exists"
            }
          },
          "op": "equal",
          "expected": true
        }
      ],
      "saveAs": "project"
    },
    {
      "id": "verify-project-target",
      "action": "studio.state",
      "input": {},
      "saveAs": "projectState",
      "assertions": [
        {
          "actual": {
            "$ref": "projectState.project.path"
          },
          "op": "equal",
          "expected": {
            "$ref": "projectPath"
          }
        },
        {
          "actual": {
            "$ref": "projectState.projectKnown"
          },
          "op": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "git-init",
      "action": "git.init",
      "input": {},
      "assertions": [
        {
          "actual": {
            "$ref": "init.kind"
          },
          "op": "equal",
          "expected": "ready"
        }
      ],
      "saveAs": "init"
    },
    {
      "id": "seed-file",
      "action": "inputMap.write",
      "input": {
        "path": "Controls/hero.input.json",
        "map": {
          "version": 2,
          "id": "hero",
          "priority": 10,
          "defaultActive": true,
          "actions": [
            {
              "id": "jump",
              "kind": "button",
              "bindings": [
                {
                  "device": "keyboard",
                  "code": "Space"
                },
                {
                  "device": "gamepad",
                  "control": "south"
                }
              ]
            }
          ]
        }
      },
      "assertions": []
    },
    {
      "id": "stage",
      "action": "git.stage",
      "input": {
        "paths": ["Controls/hero.input.json"]
      },
      "assertions": [
        {
          "actual": {
            "$ref": "staged.status.files",
            "find": {
              "path": "Controls/hero.input.json"
            },
            "pick": "stage"
          },
          "op": "equal",
          "expected": "staged"
        }
      ],
      "saveAs": "staged"
    },
    {
      "id": "commit",
      "action": "git.commit",
      "input": {
        "message": "bench: add only hero controls",
        "amend": false
      },
      "assertions": [
        {
          "actual": {
            "$ref": "committed.kind"
          },
          "op": "equal",
          "expected": "ready"
        }
      ],
      "saveAs": "committed"
    },
    {
      "id": "change",
      "action": "inputMap.write",
      "input": {
        "path": "Controls/hero.input.json",
        "map": {
          "version": 2,
          "id": "hero",
          "priority": 20,
          "defaultActive": true,
          "actions": [
            {
              "id": "jump",
              "kind": "button",
              "bindings": [
                {
                  "device": "keyboard",
                  "code": "Space"
                },
                {
                  "device": "gamepad",
                  "control": "south"
                }
              ]
            }
          ]
        }
      },
      "assertions": []
    },
    {
      "id": "stash",
      "action": "git.stash",
      "input": {
        "message": "bench hero priority"
      },
      "assertions": []
    },
    {
      "id": "list-stashes",
      "action": "git.stashes",
      "input": {},
      "assertions": [
        {
          "actual": {
            "$ref": "stashes"
          },
          "op": "length",
          "expected": 1
        }
      ],
      "saveAs": "stashes"
    },
    {
      "id": "read-reset",
      "action": "inputMap.read",
      "input": {
        "path": "Controls/hero.input.json"
      },
      "assertions": [
        {
          "actual": {
            "$ref": "reset"
          },
          "op": "equal",
          "expected": {
            "version": 2,
            "id": "hero",
            "priority": 10,
            "defaultActive": true,
            "actions": [
              {
                "id": "jump",
                "kind": "button",
                "bindings": [
                  {
                    "device": "keyboard",
                    "code": "Space"
                  },
                  {
                    "device": "gamepad",
                    "control": "south"
                  }
                ]
              }
            ]
          }
        },
        {
          "actual": {
            "$file": {
              "path": "Controls/hero.input.json",
              "read": "json"
            }
          },
          "op": "equal",
          "expected": {
            "version": 2,
            "id": "hero",
            "priority": 10,
            "defaultActive": true,
            "actions": [
              {
                "id": "jump",
                "kind": "button",
                "bindings": [
                  {
                    "device": "keyboard",
                    "code": "Space"
                  },
                  {
                    "device": "gamepad",
                    "control": "south"
                  }
                ]
              }
            ]
          }
        }
      ],
      "saveAs": "reset"
    },
    {
      "id": "pop",
      "action": "git.stashPop",
      "input": {
        "index": {
          "$ref": "stashes.0.index"
        }
      },
      "assertions": [
        {
          "actual": {
            "$ref": "popped.kind"
          },
          "op": "equal",
          "expected": "ready"
        }
      ],
      "saveAs": "popped"
    },
    {
      "id": "read-restored",
      "action": "inputMap.read",
      "input": {
        "path": "Controls/hero.input.json"
      },
      "assertions": [
        {
          "actual": {
            "$ref": "restored"
          },
          "op": "equal",
          "expected": {
            "version": 2,
            "id": "hero",
            "priority": 20,
            "defaultActive": true,
            "actions": [
              {
                "id": "jump",
                "kind": "button",
                "bindings": [
                  {
                    "device": "keyboard",
                    "code": "Space"
                  },
                  {
                    "device": "gamepad",
                    "control": "south"
                  }
                ]
              }
            ]
          }
        },
        {
          "actual": {
            "$file": {
              "path": "Controls/hero.input.json",
              "read": "json"
            }
          },
          "op": "equal",
          "expected": {
            "version": 2,
            "id": "hero",
            "priority": 20,
            "defaultActive": true,
            "actions": [
              {
                "id": "jump",
                "kind": "button",
                "bindings": [
                  {
                    "device": "keyboard",
                    "code": "Space"
                  },
                  {
                    "device": "gamepad",
                    "control": "south"
                  }
                ]
              }
            ]
          }
        }
      ],
      "saveAs": "restored"
    },
    {
      "id": "no-stashes",
      "action": "git.stashes",
      "input": {},
      "assertions": [
        {
          "actual": {
            "$ref": "remaining"
          },
          "op": "length",
          "expected": 0
        }
      ],
      "saveAs": "remaining"
    }
  ],
  "blockers": [],
  "trainingApproved": false,
  "requiredBindings": []
}
