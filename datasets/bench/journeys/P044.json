{
  "version": 1,
  "id": "P044",
  "request": "Ajoute un saut au clavier (Espace) et à la manette (bouton sud), sans modifier la carte témoin.",
  "requires": [],
  "steps": [
    {
      "id": "create-project",
      "action": "project.create",
      "input": {
        "name": "Bench Project",
        "folder": {
          "$ref": "sandbox"
        }
      },
      "assertions": [
        {
          "actual": {
            "$file": {
              "path": {
                "$ref": "projectPath"
              },
              "read": "exists"
            }
          },
          "op": "equal",
          "expected": true
