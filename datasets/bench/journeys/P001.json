{
  "version": 1,
  "id": "P001",
  "request": "« Quel est ce projet, quels documents sont ouverts et que contient-il ? »",
  "requires": ["isolated-vm"],
  "steps": [
    {
      "id": "project",
      "action": "project.create",
      "input": {
        "name": "Bench Project",
        "folder": {
          "$ref": "sandbox"
        }
      },
      "saveAs": "project",
      "assertions": [
        {
          "actual": {
            "$ref": "project.path"
          },
          "op": "equal",
          "expected": {
            "$ref": "projectPath"
          }
        }
      ]
    },
    {
      "id": "image",
      "action": "workspace.open",
      "input": {
        "workspace": "image",
        "createDocument": true,
        "title": "Composition",
        "folder": ""
      },
      "saveAs": "image",
      "assertions": [
        {
          "actual": {
            "$ref": "image.documentId"
          },
          "op": "exists"
        }
      ]
    },
    {
      "id": "resizeWitness",
      "action": "canvas.resize",
      "input": {
        "width": 640,
        "height": 360,
        "scalePixels": false
      },
      "saveAs": "resizeWitness",
      "assertions": []
    },
    {
      "id": "witnessLayer",
      "action": "layer.add",
      "input": {
        "kind": "text",
        "name": "P001 témoin persistant",
        "text": "P001 contenu vérifié",
        "x": 37,
        "y": 53
      },
      "saveAs": "witnessLayer",
      "assertions": []
    },
    {
      "id": "witnessBeforeSave",
      "action": "canvas.state",
      "input": {},
      "saveAs": "witnessBeforeSave",
      "assertions": [
        {
          "actual": {
            "$ref": "witnessBeforeSave.width"
          },
          "op": "equal",
          "expected": 640
        },
        {
          "actual": {
            "$ref": "witnessBeforeSave.height"
          },
          "op": "equal",
          "expected": 360
        },
        {
          "actual": {
            "$ref": "witnessBeforeSave.layers",
            "find": {
              "name": "P001 témoin persistant"
            },
            "pick": "text"
          },
          "op": "equal",
          "expected": "P001 contenu vérifié"
        },
        {
          "actual": {
            "$ref": "witnessBeforeSave.layers",
            "find": {
              "name": "P001 témoin persistant"
            },
            "pick": "id"
          },
          "op": "equal",
          "expected": {
            "$ref": "witnessLayer.layerId"
          }
        }
      ]
    },
    {
      "id": "saved",
      "action": "document.save",
      "input": {
        "documentId": {
          "$ref": "image.documentId"
        }
      },
      "saveAs": "saved",
      "assertions": [
        {
          "actual": {
            "$ref": "saved.written"
          },
          "op": "equal",
          "expected": true
        }
      ]
    },
    {
      "id": "before",
      "action": "studio.state",
      "input": {},
      "saveAs": "before",
      "assertions": [
        {
          "actual": {
            "$ref": "before.project.path"
          },
          "op": "equal",
          "expected": {
            "$ref": "project.path"
          }
        },
        {
          "actual": {
            "$ref": "before.documents",
            "find": {
              "title": "Composition"
            },
            "pick": "id"
          },
          "op": "equal",
          "expected": {
            "$ref": "image.documentId"
          }
        }
      ]
    },
    {
      "id": "docs",
      "action": "documents.list",
      "input": {},
      "saveAs": "docs",
      "assertions": [
        {
          "actual": {
            "$ref": "docs",
            "find": {
              "title": "Composition"
            },
            "pick": "id"
          },
          "op": "equal",
          "expected": {
            "$ref": "image.documentId"
          }
        }
      ]
    },
    {
      "id": "files",
      "action": "files.list",
      "input": {
        "folder": ""
      },
      "saveAs": "files",
      "assertions": []
    },
    {
      "id": "counts",
      "action": "assets.counts",
      "input": {},
      "saveAs": "counts",
      "assertions": []
    },
    {
      "id": "after",
      "action": "studio.state",
      "input": {},
      "saveAs": "after",
      "assertions": [
        {
          "actual": {
            "$ref": "after.project"
          },
          "op": "equal",
          "expected": {
            "$ref": "before.project"
          }
        },
        {
          "actual": {
            "$ref": "after.documents"
          },
          "op": "equal",
          "expected": {
            "$ref": "before.documents"
          }
        }
      ]
    }
  ],
  "blockers": [],
  "trainingApproved": false
}
