{
  "version": 1,
  "id": "P012",
  "request": "« Annule la génération en cours. »",
  "requires": [
    "isolated-vm",
    "installed-image-model-fixture",
    "cancellable-generation-provider",
    "generation-spend-authorized"
  ],
  "steps": [
    {
      "id": "project",
      "action": "project.create",
      "input": {
        "name": "Bench Project",
        "folder": {
          "$ref": "sandbox"
        }
      },
      "saveAs": "project",
      "assertions": [
        {
          "actual": {
            "$ref": "project.path"
          },
          "op": "equal",
          "expected": {
            "$ref": "projectPath"
          }
        }
      ]
    },
    {
      "id": "image",
      "action": "workspace.open",
      "input": {
        "workspace": "image",
        "createDocument": true,
        "title": "Composition",
        "folder": ""
      },
      "saveAs": "image",
      "assertions": [
        {
          "actual": {
            "$ref": "image.documentId"
          },
          "op": "exists"
        }
      ]
    },
    {
      "id": "fields",
      "action": "models.readGenerationModelFields",
      "input": {
        "modelId": {
          "$ref": "fixture.modelId"
        }
      },
      "saveAs": "fields",
      "assertions": []
    },
    {
      "id": "jobsBefore",
      "action": "jobs.list",
      "input": {},
      "saveAs": "jobsBefore",
      "assertions": []
    },
    {
      "id": "prepare",
      "action": "generator.prepare",
      "input": {
        "family": "image",
        "modelId": {
          "$ref": "fixture.modelId"
        },
        "parameters": {
          "$ref": "fixture.parameters"
        },
        "operation": "img2img"
      },
      "saveAs": "prepare",
      "assertions": []
    },
    {
      "id": "armed",
      "action": "generator.readArmedGeneration",
      "input": {},
      "saveAs": "armed",
      "assertions": [
        {
          "actual": {
            "$ref": "armed.modelId"
          },
          "op": "equal",
          "expected": {
            "$ref": "fixture.modelId"
          }
        },
        {
          "actual": {
            "$ref": "armed.parameters"
          },
          "op": "equal",
          "expected": {
            "$ref": "fixture.parameters"
          }
        }
      ]
    },
    {
      "id": "submit",
      "action": "generator.submit",
      "input": {
        "landing": "newTab"
      },
      "saveAs": "submit",
      "assertions": []
    },
    {
      "id": "cancel",
      "action": "job.cancelCloudGeneration",
      "input": {
        "jobId": {
          "$ref": "submit.jobId"
        }
      },
      "saveAs": "cancel",
      "assertions": []
    },
    {
      "id": "wait",
      "action": "job.waitForCloudGeneration",
      "input": {
        "jobId": {
          "$ref": "submit.jobId"
        },
        "timeoutMs": 110000
      },
      "saveAs": "wait",
      "assertions": [
        {
          "actual": {
            "$ref": "wait.id"
          },
          "op": "equal",
          "expected": {
            "$ref": "submit.jobId"
          }
        },
        {
          "actual": {
            "$ref": "wait.status"
          },
          "op": "equal",
          "expected": "cancelled"
        }
      ]
    }
  ],
  "blockers": [
    "Fixture de modèle installée et schéma provider non disponibles dans la VM de référence ; sélectionner et figer ce couple avant exécution.",
    "Course avec fin de génération : branche succès préalable/refus du provider doit être testée séparément ; aucune promesse de remboursement."
  ],
  "trainingApproved": false,
  "requiredBindings": ["fixture"]
}
