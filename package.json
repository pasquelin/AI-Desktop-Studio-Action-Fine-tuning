{
  "name": "ai-desktop-studio-action-fine-tuning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24.8.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "config:check": "node tools/check-config.ts",
    "repo:check": "node tools/check-repository.ts",
    "validate": "npm run admin:build && npm run lint && npm run typecheck && npm test && npm run unused:check && npm run config:check && npm run repo:check && npm run freshness:check && npm run catalogue:check",
    "catalogue:export": "node tools/export-catalogue.ts",
    "catalogue:check": "node tools/check-catalogue.ts",
    "vm": "node tools/vm.ts",
    "freshness:check": "node tools/check-freshness.ts",
    "vm:run": "node tools/run-vm.ts",
    "vm:scenario": "node tools/run-vm.ts --scenario",
    "vm:observe": "node tools/observe-vm.ts",
    "start": "node tools/run-vm.ts --scenario",
    "model:pull": "node tools/model.ts pull",
    "model:check": "node tools/model.ts check",
    "model:eval": "node tools/model.ts evaluate",
    "scenarios:prepare": "node tools/prepare-scenarios.ts",
    "scenarios:split": "node tools/prepare-splits.ts",
    "scenarios:examples": "node tools/prepare-examples.ts",
    "locales:draft": "node tools/draft-locales.ts",
    "bench:run": "node tools/run-vm.ts --scenario",
    "dataset:export": "node tools/export-approved.ts",
    "bench:check": "node tools/check-bench.ts",
    "fixtures:prepare": "node tools/prepare-media-fixtures.ts",
    "prepare:bench": "npm run fixtures:prepare && npm run scenarios:prepare && npm run scenarios:examples && npm run scenarios:split && npm run bench:check",
    "admin:build": "node tools/build-admin.ts",
    "unused:check": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/view": "6.43.11",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@uiw/react-codemirror": "4.25.11",
    "ajv": "8.20.0",
    "daisyui": "5.7.28",
    "jsdom": "30.0.1",
    "knip": "6.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
